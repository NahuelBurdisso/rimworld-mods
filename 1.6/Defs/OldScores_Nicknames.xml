<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Raiders who see a colonist their faction has nicknamed may break and run from her.
       Same state class as Odyssey's Terror (which needs Odyssey), wired into the think tree by
       Patches/OldScores_ThinkTree.xml. JobGiver_FleeTerror flees from MentalState.causedByPawn. -->
  <MentalStateDef>
    <defName>OldScores_Dread</defName>
    <label>dread</label>
    <stateClass>Verse.AI.MentalState_Terror</stateClass>
    <category>Misc</category>
    <nameColor>(0.65, 0.9, 0.93)</nameColor>
    <baseInspectLine>Mental state: Running from a legend</baseInspectLine>
    <blockNormalThoughts>true</blockNormalThoughts>
    <minTicksBeforeRecovery>300</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>600</maxTicksBeforeRecovery>
    <recoveryMtbDays>0.3</recoveryMtbDays>
  </MentalStateDef>

  <!-- Icon thrown over a raider when he falls into dread (FleckMaker.ThrowMetaIcon). -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>OldScores_Fleck_Dread</defName>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>0.8</solidTime>
    <fadeOutTime>0.6</fadeOutTime>
    <graphicData>
      <texPath>Things/OldScores/DreadIcon</texPath>
      <drawSize>(0.7, 0.7)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- Root keyword r_name. Constants: weapon (melee/ranged/none), trait (see Nicknames.cs), PAWN_gender.
       Rule WEAPON_label exists only when armed. Words are capitalised here: the code does not title-case. -->
  <RulePackDef>
    <defName>OldScores_Namer_EnemyNickname</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name(p=4)->the [adj] [noun]</li>
        <li>r_name(p=2)->the [noun] of [place]</li>
        <li>r_name(p=1)->the [noun] Nobody Ordered</li>
        <li>r_name(weapon==ranged,p=3)->the [WEAPON_label] [ghost]</li>
        <li>r_name(weapon==melee,p=3)->the [WEAPON_label] [ghost]</li>
        <li>r_name(weapon==melee,p=3)->the [adj] [meleeNoun]</li>
        <li>r_name(weapon==ranged,p=3)->the [adj] [rangedNoun]</li>
        <li>r_name(weapon==none,p=4)->the [adj] [fistNoun]</li>
        <li>r_name(PAWN_gender==Female,p=1)->the [adj] [femaleNoun]</li>
        <li>r_name(trait==Tough,p=6)->the Unkillable [noun]</li>
        <li>r_name(trait==Tough,p=3)->the [noun] That Would Not Die</li>
        <li>r_name(trait==Brawler,p=6)->the [adj] Knuckles</li>
        <li>r_name(trait==Pyromaniac,p=6)->the [adj] Matchstick</li>
        <li>r_name(trait==Nimble,p=6)->the Greased [noun]</li>
        <li>r_name(trait==Wimp,p=6)->the Screaming [noun]</li>
        <li>r_name(trait==Bloodlust,p=6)->the [adj] Butcher</li>
        <li>r_name(trait==Psychopath,p=6)->the Smiling [noun]</li>
        <li>r_name(trait==Kind,p=6)->the Apologetic [noun]</li>
        <li>r_name(trait==Cannibal,p=6)->the Hungry [noun]</li>
        <li>r_name(trait==Masochist,p=6)->the Grinning [noun]</li>
        <li>r_name(trait==Gourmand,p=6)->the [adj] Lunchbox</li>
        <li>r_name(trait==Ascetic,p=6)->the [adj] Monk</li>

        <li>adj->Unkillable</li>
        <li>adj->Grinning</li>
        <li>adj->Quiet</li>
