        <li>adj->Barefoot</li>
        <li>adj->Tireless</li>
        <li>adj->Smoking</li>
        <li>adj->Iron</li>
        <li>adj->Rusty</li>
        <li>adj->Midnight</li>
        <li>adj->Cheerful</li>
        <li>adj->Terrible</li>
        <li>adj->Silent</li>
        <li>adj->Unstoppable</li>
        <li>adj->Very Angry</li>
        <li>adj->Humming</li>
        <li>adj->Last</li>

        <li>noun->Toaster</li>
        <li>noun->Kettle</li>
