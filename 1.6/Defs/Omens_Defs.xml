<Defs>

  <!-- ============ Rain Reveals the Unseen ============ -->

  <!-- Copy of vanilla GroundWaterSplash (Core/Defs/Effects/Fleck_Visual.xml), brighter and nearly opaque
       so the ring around a hidden pawn reads through the rain overlay. -->
