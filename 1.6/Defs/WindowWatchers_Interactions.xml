<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Never chosen at random (base InteractionWorker weight is 0); only JobDriver_Reunite uses it. -->
  <InteractionDef>
    <defName>WW_Embrace</defName>
    <label>embrace</label>
    <symbol>Things/Mote/WindowWatchers/Embrace</symbol>
    <recipientThought>WW_Embraced</recipientThought>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] [hugged] [RECIPIENT_nameDef] after the fight, [relieved].</li>
        <li>hugged->hugged</li>
        <li>hugged->embraced</li>
        <li>hugged->held on to</li>
        <li>hugged->threw [INITIATOR_possessive] arms around</li>
        <li>relieved->relieved to see [RECIPIENT_objective] standing</li>
        <li>relieved->having watched the whole thing from cover</li>
        <li>relieved->not wanting to let go</li>
      </rulesStrings>
    </logRulesInitiator>
  </InteractionDef>

  <!-- Worry bubble: a thought cloud with an eye icon and the vanilla arrow toward the loved one. Maintained by the job. -->
  <ThingDef ParentName="InteractionMoteBase">
    <defName>WW_Mote_Worry</defName>
    <thingClass>WindowWatchers.MoteBubble_Worry</thingClass>
    <graphicData>
      <texPath>Things/Mote/Thought</texPath>
      <drawSize>1.25</drawSize>
    </graphicData>
    <mote>
      <fadeInTime>0.2</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.6</fadeOutTime>
      <needsMaintenance>true</needsMaintenance>
      <fadeOutUnmaintained>true</fadeOutUnmaintained>
    </mote>
  </ThingDef>

  <!-- Same bubble, red and trembling, shown for a few seconds when the loved one falls. -->
  <ThingDef ParentName="InteractionMoteBase">
    <defName>WW_Mote_Grief</defName>
    <thingClass>WindowWatchers.MoteBubble_Worry</thingClass>
    <graphicData>
      <texPath>Things/Mote/Thought</texPath>
      <drawSize>1.25</drawSize>
    </graphicData>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <solidTime>4</solidTime>
      <fadeOutTime>1</fadeOutTime>
    </mote>
  </ThingDef>

</Defs>
